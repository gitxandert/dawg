#!/usr/bin/env bash
# dawg - send push notifications through Bark (iOS) or ntfy (Android).
#
# Usage:
#   dawg [options] MESSAGE            send a message
#   echo MESSAGE | dawg [options]     send stdin as the message
#   dawg [options] run -- CMD ARGS..  run a command, notify when it finishes
#   dawg ask [-w] MESSAGE OPT [OPT..] ask for a reply (see: dawg ask -h)
#   dawg status -T ID busy|blocked|idle [NOTE]   set a thread's inbox status
#   dawg inbox -T ID [-w]             print messages queued from the inbox
#   dawg thread new -t TITLE          start an inbox thread; prints its id
#   dawg statusline                   Claude Code status line; reports usage to the inbox
#
# Options:
#   -T THREAD   inbox thread to post to (default: $DAWG_THREAD, else the
#               Notifications thread); the text links to it, and a thread
#               muted in the inbox gets no texts
#   -t TITLE    notification title (default: hostname)
#   -g GROUP    group notifications in Bark; tag notifications in ntfy
#   -l LEVEL    active | timeSensitive | passive | critical
#   -s SOUND    Bark sound name (e.g. alarm, bell, minuet)
#   -u URL      URL to open when tapped
#   -a ACTION   Bark tap action; "none" makes tapping do nothing
#
# Config:
#   DAWG_PROVIDER    bark (default) or ntfy; or ~/.config/dawg/provider
#   DAWG_KEY         Bark device key or ntfy topic; or ~/.config/dawg/key
#   DAWG_SERVER      server URL; or ~/.config/dawg/server
#                    defaults: https://api.day.app (Bark), https://ntfy.sh (ntfy)
#   DAWG_NTFY_TOKEN  optional ntfy access token; or ~/.config/dawg/ntfy_token

set -u

dawgd="$(dirname "$(readlink -f "$0")")/dawgd.py"
subcommand() { [[ "${1:-}" =~ ^(ask|status|inbox|thread|statusline)$ ]]; }
subcommand "${1:-}" && exec python3 "$dawgd" "$@"

config_value() {
  local value="${!1:-}"
  if [[ -z "$value" && -r "$HOME/.config/dawg/$2" ]]; then
    value="$(tr -d '[:space:]' < "$HOME/.config/dawg/$2")"
  fi
  printf '%s' "${value:-${3:-}}"
}

provider="$(config_value DAWG_PROVIDER provider bark)"
case "$provider" in
  bark) default_server="https://api.day.app"; key_name="Bark device key" ;;
  ntfy) default_server="https://ntfy.sh"; key_name="ntfy topic" ;;
  *) echo "dawg: unknown provider '$provider'; use bark or ntfy" >&2; exit 2 ;;
esac
server="$(config_value DAWG_SERVER server "$default_server")"
key="$(config_value DAWG_KEY key)"
if [[ -z "$key" ]]; then
  echo "dawg: no $key_name; set DAWG_KEY or write it to ~/.config/dawg/key" >&2
  exit 2
fi
if [[ "$provider" == "ntfy" && ! "$key" =~ ^[A-Za-z0-9_-]{1,64}$ ]]; then
  echo "dawg: invalid ntfy topic; use letters, numbers, _ and -, up to 64 characters" >&2
  exit 2
fi

title="$(hostname)"
group="" level="" sound="" url="" action="" thread="${DAWG_THREAD:-notifications}"
given=()  # -T, -t and -g as given, for a subcommand that comes after them
while getopts ":T:t:g:l:s:u:a:h" opt; do
  case "$opt" in
    T) thread="$OPTARG"; given+=(-T "$OPTARG") ;;
    t) title="$OPTARG"; given+=(-t "$OPTARG") ;;
    g) group="$OPTARG"; given+=(-g "$OPTARG") ;;
    l) level="$OPTARG" ;;
    s) sound="$OPTARG" ;;
    u) url="$OPTARG" ;;
    a) action="$OPTARG" ;;
    h) sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "dawg: bad option -$OPTARG" >&2; exit 2 ;;
  esac
done
shift $((OPTIND - 1))

# `dawg -T ID status busy` means the subcommand, not a message.
if subcommand "${1:-}"; then
  sub="$1"; shift
  args=()
  for ((i = 0; i < ${#given[@]}; i += 2)); do
    case "$sub:${given[i]}" in  # only the options each subcommand takes
      ask:*|status:-[Tt]|inbox:-[Tt]|thread:-t) args+=("${given[i]}" "${given[i+1]}") ;;
    esac
  done
  exec python3 "$dawgd" "$sub" "${args[@]}" "$@"
fi

send() {
  local body="$1"
  # dawgd posts it to the thread, then calls back here with DAWG_DIRECT set to text it.
  if [[ -z "${DAWG_DIRECT:-}" ]]; then
    local opts=(-T "$thread" -t "$title")
    [[ -n "$group" ]] && opts+=(-g "$group")
    [[ -n "$level" ]] && opts+=(-l "$level")
    [[ -n "$sound" ]] && opts+=(-s "$sound")
    [[ -n "$url"   ]] && opts+=(-u "$url")
    python3 "$dawgd" send "${opts[@]}" -- "$body"
    return
  fi
  local args=(-sS --max-time 10 -X POST)
  if [[ "$provider" == "ntfy" ]]; then
    local payload token
    payload="$(python3 - "$key" "$title" "$body" "$group" "$level" "$url" <<'PY'
import json, sys
topic, title, message, group, level, url = sys.argv[1:]
payload = {"topic": topic, "title": title, "message": message}
if group:
    payload["tags"] = [group]
if level:
    payload["priority"] = {"passive": 2, "active": 3, "timeSensitive": 4, "critical": 5}.get(level, 3)
if url:
    payload["click"] = url
print(json.dumps(payload))
PY
)" || return 1
    args+=(--fail "${server%/}/" -H "Content-Type: application/json" --data-binary "$payload")
    token="$(config_value DAWG_NTFY_TOKEN ntfy_token)"
    [[ -n "$token" ]] && args+=(-H "Authorization: Bearer $token")
  else
    args+=("${server%/}/$key" --data-urlencode "title=$title" --data-urlencode "body=$body")
    [[ -n "$group" ]] && args+=(--data-urlencode "group=$group")
    [[ -n "$level" ]] && args+=(--data-urlencode "level=$level")
    [[ -n "$sound" ]] && args+=(--data-urlencode "sound=$sound")
    [[ -n "$url"   ]] && args+=(--data-urlencode "url=$url")
    [[ -n "$action" ]] && args+=(--data-urlencode "action=$action")
  fi
  local resp
  if ! resp="$(curl "${args[@]}")"; then
    echo "dawg: request failed" >&2
    return 1
  fi
  if [[ "$provider" == "bark" && "$resp" != *'"code":200'* ]]; then
    echo "dawg: server error: $resp" >&2
    return 1
  fi
}

if [[ "${1:-}" == "run" ]]; then
  shift
  [[ "${1:-}" == "--" ]] && shift
  if [[ $# -eq 0 ]]; then
    echo "dawg: run needs a command" >&2
    exit 2
  fi
  start=$(date +%s)
  "$@"
  status=$?
  elapsed=$(( $(date +%s) - start ))
  dur=$(printf '%dh%02dm%02ds' $((elapsed/3600)) $((elapsed%3600/60)) $((elapsed%60)))
  if [[ $status -eq 0 ]]; then
    send "✅ $* — finished in $dur"
  else
    send "❌ $* — exit $status after $dur"
  fi
  exit $status
fi

if [[ $# -gt 0 ]]; then
  msg="$*"
elif [[ ! -t 0 ]]; then
  msg="$(cat)"
else
  echo "dawg: no message (try -h)" >&2
  exit 2
fi
send "$msg"
